# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Public: these are bundled into the app (EXPO_PUBLIC_ prefix) ---
# Supabase → Project Settings → API. The publishable key is safe to ship;
# row level security protects the data. Never use the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server only: read by src/app/api/*+api.ts, never bundled into the app ---
# Do NOT add the EXPO_PUBLIC_ prefix to these.
ANTHROPIC_API_KEY=sk-ant-...
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gluey
